generator client {
  provider = "prisma-client-js"
  // relationJoins faz o Prisma resolver relacao aninhada com JOIN, numa ida
  // so ao banco. Sem isso, cada `include`/`select` aninhado vira uma consulta
  // separada: carregar usuario + assinatura + filhos custava TRES viagens, e
  // receita + ingredientes + alimento, mais tres. Com o banco em sa-east-1 a
  // ~14 ms por viagem, era isso que deixava toda tela lenta.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Praticidade {
  MUITO_RAPIDO
  EQUILIBRADO
  PODE_COZINHAR_MAIS
}

enum Objetivo {
  ORGANIZAR_ROTINA
  VARIAR_CARDAPIO
  APRESENTAR_NOVOS_ALIMENTOS
  REDUZIR_IMPROVISO
}

enum TipoRefeicao {
  CAFE_DA_MANHA
  ALMOCO
  LANCHE
  JANTAR
}

enum StatusPreferencia {
  ACEITA
  RECUSA
  DESEJADA
  RESTRICAO
}

enum EstadoFeedback {
  GOSTOU
  ACEITOU
  EXPERIMENTOU
  RECUSOU
}

enum StatusSlot {
  PLANEJADO
  TROCADO
  FORA_DE_CASA
  SEM_TEMPO
  CONCLUIDO
}

enum PlanoAssinatura {
  ESSENCIAL
  FAMILIA
}

enum StatusAssinatura {
  TESTE
  ATIVA
  CANCELADA
  CARENCIA
}

enum PapelUsuario {
  RESPONSAVEL
  ADMIN
  /** Parceira: ve o proprio painel de indicacoes, nunca o backoffice. */
  PARCEIRA
}

enum QualidadeSono {
  BOA
  REGULAR
  RUIM
}

enum NivelDisposicao {
  BAIXA
  NORMAL
  ALTA
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  telefone      String?
  passwordHash  String
  role          PapelUsuario @default(RESPONSAVEL)
  lembretes     Boolean  @default(true)
  // Quando o ultimo lembrete foi enviado — impede mandar duas vezes no mesmo
  // dia se o cron rodar de novo.
  ultimoLembreteEm DateTime?
  notificacoes  Notificacao[]
  pushSubscriptions PushSubscription[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  children      ChildProfile[]
  subscription  Subscription?
  auditLogs     AuditLog[]
  cancelamentos SolicitacaoCancelamento[]
  convitesCriados ConviteCortesia[] @relation("ConvitesCriados")
  parceira      Parceira?
  indicacao     Indicacao?
}

/**
 * Parceira de divulgacao.
 *
 * Loga com a MESMA conta do app — nao existe login separado, que seria mais
 * uma senha para vazar. O que muda e o papel: PARCEIRA abre /parceira e nada
 * mais. Ela nunca chega ao backoffice.
 */
model Parceira {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Nome publico, como ela quer aparecer. */
  nome        String
  /** Slug curto e estavel: pratinhofeliz.com.br/p/<codigo>. */
  codigo      String   @unique
  /**
   * Percentual da comissao. Fica congelado em cada indicacao no momento em
   * que ela acontece: renegociar a porcentagem nao pode mudar o valor do que
   * ja foi indicado meses atras.
   */
  comissaoPct Float    @default(30)
  ativa       Boolean  @default(true)
  observacao  String?
  /**
   * Chave PIX de repasse. E dado pessoal e fica aqui pelo tempo da parceria —
   * so o admin le, e a propria parceira pode apagar quando quiser.
   */
  chavePix    String?
  links       LinkParceira[]
  indicacoes  Indicacao[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * Um link de divulgacao.
 *
 * Mais de um por parceira de proposito: o link da bio e o link do story
 * respondem perguntas diferentes, e sem separar nao da para saber qual peca
 * funcionou.
 */
model LinkParceira {
  id             String    @id @default(cuid())
  parceiraId     String
  parceira       Parceira  @relation(fields: [parceiraId], references: [id], onDelete: Cascade)
  slug           String    @unique
  rotulo         String
  cliques        Int       @default(0)
  ultimoCliqueEm DateTime?
  revogadoEm     DateTime?
  indicacoes     Indicacao[]
  createdAt      DateTime  @default(now())

  @@index([parceiraId])
}

/**
 * Quem veio por qual parceira.
 *
 * Uma conta pertence a no maximo uma parceira (userId unico): primeira
 * indicacao vence. Sem isso, duas parceiras poderiam reivindicar a mesma
 * pessoa e a comissao sairia dobrada.
 */
model Indicacao {
  id          String   @id @default(cuid())
  parceiraId  String
  parceira    Parceira @relation(fields: [parceiraId], references: [id], onDelete: Cascade)
  linkId      String?
  link        LinkParceira? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Copia do percentual vigente quando a indicacao entrou. */
  comissaoPct Float
  createdAt   DateTime @default(now())

  @@index([parceiraId, createdAt])
}

model ChildProfile {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome                String
  faixaEtaria         String
  refeicoesPorDia     Int      @default(4)
  tempoDisponivel     Int      @default(30)
  praticidade         Praticidade @default(EQUILIBRADO)
  objetivo            Objetivo @default(ORGANIZAR_ROTINA)
  equipamentos        String?
  horarioDormirHabitual  String?
  horarioAcordarHabitual String?
  consentimentoLgpd   Boolean  @default(false)
  onboardingCompleto  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  preferences   FoodPreference[]
  mealPlans     MealPlan[]
  favorites     Favorite[]
  pantryItems   PantryItem[]
  foodJourneys  FoodJourney[]
  reports       MonthlyReport[]
  shoppingChecks ShoppingCheck[]
  routineEntries RoutineEntry[]
  shoppingExtras ShoppingExtra[]
}

model Ingredient {
  id        String   @id @default(cuid())
  nome      String   @unique
  categoria String

  // Composição nutricional por 100 g de parte comestível.
  // Origem: TACO — Tabela Brasileira de Composição de Alimentos (NEPA/UNICAMP, 4a ed.).
  // `tacoDescricao` guarda o alimento exato usado, para a informação ser auditável.
  tacoId          Int?
  tacoDescricao   String?
  energiaKcal     Float?
  proteinaG       Float?
  carboidratoG    Float?
  lipideoG        Float?
  fibraG          Float?
  calcioMg        Float?
  ferroMg         Float?
  sodioMg         Float?
  vitaminaCMg     Float?
  zincoMg         Float?

  // Nutrientes usados nas sugestões por rotina (sono / energia / regulação).
  triptofanoG     Float?
  magnesioMg      Float?
  potassioMg      Float?
  tiaminaMg       Float?
  riboflavinaMg   Float?
  piridoxinaMg    Float?
  niacinaMg       Float?

  // Peso médio de 1 unidade, quando o ingrediente é contado por unidade (ex.: 1 ovo ≈ 50 g).
  // Atenção: é a medida usada NAS RECEITAS (1 dente de alho = 3 g), não a de compra.
  gramasPorUnidade Float?

  // Como este item é COMPRADO no mercado. Serve para transformar o total de
  // gramas do plano em algo acionável na lista: "5 abacates", "1,2 kg", "2 L".
  // UNIDADE | GRAMAS | ML
  unidadeCompra String  @default("GRAMAS")
  // Peso de 1 unidade de compra (1 abacate = 200 g, 1 cabeça de alho = 50 g).
  gramasCompra  Float?
  // Substantivo da unidade de compra quando não é "unidade": maço, cabeça, lata, pote.
  rotuloCompra  String?

  foodPreferences FoodPreference[]
  recipeItems     RecipeIngredient[]
  pantryItems     PantryItem[]
  foodJourneys    FoodJourney[]
  shoppingChecks  ShoppingCheck[]
}

model FoodPreference {
  id             String   @id @default(cuid())
  childProfileId String
  child          ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])
  status         StatusPreferencia
  observacao     String?
  createdAt      DateTime @default(now())

  @@unique([childProfileId, ingredientId, status])
}

model Recipe {
  id             String   @id @default(cuid())
  nome           String
  resumo         String
  tipoRefeicao   TipoRefeicao
  tempoPreparoMin Int
  dificuldade    String
  rendimento     String
  passos         String
  tags           String
  restricoes     String
  nutricao       String   @default("")
  idadeMinimaMeses Int    @default(6)
  /// Equipamentos exigidos pelo modo de preparo, separados por virgula. Vazio = so fogao e panela.
  equipamentos     String   @default("")
  imagemUrl      String?
  fonte          String?
  porcoes        Int      @default(1)

  // Aptidão da receita para cada objetivo de rotina, de 0 a 100.
  // Derivada da composição dos ingredientes por `npm run db:rotina` — não é
  // preenchida à mão. Ver src/lib/objetivosRotina.ts para os critérios.
  scoreSono      Float?
  scoreEnergia   Float?
  scoreCalma     Float?

  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Variacao gerada a partir de outra receita (troca de proteina ou de
  // tuberculo por equivalente). Multiplica o catalogo sem escrever receita
  // nova; a base fica registrada para dar para regerar ou remover em bloco.
  baseRecipeId   String?
  baseRecipe     Recipe?  @relation("VariacoesDaReceita", fields: [baseRecipeId], references: [id], onDelete: Cascade)
  variacoes      Recipe[] @relation("VariacoesDaReceita")
  /// Nome do ingrediente que foi trocado em relacao a base.
  variacaoTroca  String?

  ingredients   RecipeIngredient[]
  mealSlots     MealSlot[]
  favorites     Favorite[]
}

model RecipeIngredient {
  id           String   @id @default(cuid())
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantidade   String
  // Peso estimado em gramas desta quantidade, usado no cálculo nutricional.
  // Nulo quando a medida não é convertível (ex.: "a gosto") — nesse caso o
  // ingrediente é ignorado no cálculo e a receita fica marcada como estimativa parcial.
  gramas       Float?

  @@unique([recipeId, ingredientId])
}

model MealPlan {
  id             String   @id @default(cuid())
  childProfileId String
  child          ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  cicloNumero    Int
  dataInicio     DateTime
  dataFim        DateTime
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())

  slots   MealSlot[]
  reports MonthlyReport[]
}

model MealSlot {
  id           String   @id @default(cuid())
  mealPlanId   String
  mealPlan     MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  data         DateTime
  tipo         TipoRefeicao
  recipeId     String?
  recipe       Recipe?  @relation(fields: [recipeId], references: [id])
  status       StatusSlot @default(PLANEJADO)
  explicacao   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  feedback MealFeedback?

  @@unique([mealPlanId, data, tipo])
}

model MealFeedback {
  id         String   @id @default(cuid())
  mealSlotId String   @unique
  mealSlot   MealSlot @relation(fields: [mealSlotId], references: [id], onDelete: Cascade)
  estado     EstadoFeedback
  observacao String?
  createdAt  DateTime @default(now())
}

model PantryItem {
  id             String   @id @default(cuid())
  childProfileId String
  child          ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])
  createdAt      DateTime @default(now())

  @@unique([childProfileId, ingredientId])
}

model FoodJourney {
  id             String   @id @default(cuid())
  childProfileId String
  child          ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])
  exposicoes     Int      @default(0)
  ultimoEstado   EstadoFeedback?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([childProfileId, ingredientId])
}

model Favorite {
  id             String   @id @default(cuid())
  childProfileId String
  child          ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  recipeId       String
  recipe         Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  origem         String   @default("manual")
  createdAt      DateTime @default(now())

  @@unique([childProfileId, recipeId])
}

model MonthlyReport {
  id             String   @id @default(cuid())
  childProfileId String
  child          ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  mealPlanId     String
  mealPlan       MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  diasAcompanhados Int
  receitasDiferentes Int
  alimentosApresentados Int
  alimentosAceitos Int
  createdAt      DateTime @default(now())
}

model RoutineEntry {
  id               String   @id @default(cuid())
  childProfileId   String
  child            ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  data             DateTime
  horasSono        Float?
  qualidadeSono    QualidadeSono?
  atividadeMinutos Int?
  tipoAtividade    String?
  disposicao       NivelDisposicao?
  observacao       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([childProfileId, data])
}

/// Item avulso que a família adiciona à lista de compras, fora do que vem do plano.
model ShoppingExtra {
  id             String   @id @default(cuid())
  childProfileId String
  child          ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  semanaInicio   DateTime
  nome           String
  quantidade     String?
  categoria      String   @default("OUTROS")
  comprado       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([childProfileId, semanaInicio])
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plano        PlanoAssinatura @default(ESSENCIAL)
  status       StatusAssinatura @default(TESTE)
  renovaEm     DateTime?

  // Vinculo com o Stripe. Ausentes ate a pessoa passar pelo Checkout.
  // Um TESTE so libera o app quando ha stripeSubscriptionId de verdade;
  // sem isso, o cadastro novo cai no paywall.
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)

  // Acesso de cortesia liberado pelo admin (parceiras, convidados, imprensa).
  // Independe do Stripe: libera o app sem cobranca e sem entrar na receita.
  acessoCortesia   Boolean   @default(false)
  cortesiaMotivo   String?
  cortesiaEm       DateTime?

  // Convite que originou a cortesia, quando ela veio de um link em vez do
  // botao na lista de usuarios. Guarda a origem para o admin saber qual link
  // trouxe cada pessoa.
  conviteId        String?
  convite          ConviteCortesia? @relation(fields: [conviteId], references: [id], onDelete: SetNull)

  // Pagamento pela Cakto. O Stripe continua nos campos acima para quem assinou
  // antes da troca de gateway; os dois convivem sem se atrapalhar.
  caktoAssinaturaId String?  @unique
  caktoRefId        String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ShoppingCheck {
  id             String   @id @default(cuid())
  childProfileId String
  child          ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  semanaInicio   DateTime
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])
  comprado       Boolean  @default(true)
  // Quanto a pessoa REALMENTE pegou no mercado. A sugestao do plano fica so
  // como referencia. Guardado na unidade base do ingrediente: contagem para
  // itens por unidade, gramas (ou ml) para os demais.
  quantidadeComprada Float?
  createdAt      DateTime @default(now())

  @@unique([childProfileId, semanaInicio, ingredientId])
}

/// Notificacao que a familia ve dentro do app, na aba do sino.
model Notificacao {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PLANO | LEMBRETE | DICA | SISTEMA — define o icone e a cor.
  tipo      String   @default("SISTEMA")
  titulo    String
  corpo     String
  /// Para onde o toque leva (ex.: "/hoje").
  link      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, lida])
  @@index([userId, createdAt])
}

/// Inscricao de push do navegador. Uma por aparelho.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Quando o navegador rejeitou a inscricao (aparelho desinstalou o app).
  invalidaEm DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

/**
 * Link de cadastro com acesso de cortesia.
 *
 * O admin gera o link e envia para a pessoa; quem se cadastra por ele ja nasce
 * com acessoCortesia e nao passa pelo paywall. O token e a credencial do
 * convite: quem tem o link consegue criar a conta, por isso ele e sorteado,
 * tem limite de usos e pode expirar ou ser revogado.
 */
model ConviteCortesia {
  id          String   @id @default(cuid())
  token       String   @unique
  rotulo      String
  motivo      String?
  maxUsos     Int      @default(1)
  usos        Int      @default(0)
  expiraEm    DateTime?
  revogadoEm  DateTime?
  criadoPorId String
  criadoPor   User     @relation("ConvitesCriados", fields: [criadoPorId], references: [id], onDelete: Cascade)
  assinaturas Subscription[]
  createdAt   DateTime @default(now())
}

/**
 * Compra registrada pelo webhook da Cakto.
 *
 * O checkout deles e hospedado fora: a pessoa paga sem estar logada e sem
 * conta nenhuma. O webhook chega primeiro, cria esta linha, e ela e o que
 * permite a pessoa reivindicar o acesso depois em /acesso.
 *
 * O `id` e o id do evento na Cakto, o que da idempotencia de graca — reenvio
 * do mesmo evento cai no mesmo registro em vez de duplicar a compra.
 */
model CompraCakto {
  id           String    @id
  refId        String?
  evento       String
  status       String
  email        String
  nome         String?
  // Ultimos quatro digitos do CPF informado no pagamento. Serve de conferencia
  // na hora de reivindicar o acesso; o documento inteiro nao e guardado.
  docLast4     String?
  valor        Float?
  produtoNome  String?
  ofertaId     String?
  assinaturaId String?
  // Preenchidos quando a compra vira acesso de verdade.
  userId       String?
  liberadaEm   DateTime?
  // Tentativas erradas de reivindicar, para travar quem fica adivinhando.
  tentativas   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

/**
 * Marcos do funil, gravados pelo proprio site.
 *
 * Existe para responder "de onde veio quem paga" sem depender de ferramenta
 * externa nem do pixel — bloqueador de anuncio derruba o navegador, nao o
 * servidor. Guarda so os passos do funil, nao page view bruto.
 *
 * A atribuicao vem do cookie de primeira parte gravado na chegada: a UTM do
 * primeiro toque acompanha a sessao ate a compra.
 */
model EventoFunil {
  id          String   @id @default(cuid())
  // Mesma sessao usada pelo mapa de calor, quando existir.
  sessionId   String?
  etapa       String
  path        String?
  valor       Float?
  // Identificacao possivel do lado de ca. O e-mail e o que permite casar a
  // compra da Cakto — que chega sem cookie — com a visita que a originou.
  userId      String?
  email       String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?
  referrer    String?
  viewport    String?
  createdAt   DateTime @default(now())

  @@index([etapa, createdAt])
  @@index([createdAt])
  @@index([utmCampaign])
  @@index([email])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  evento    String
  detalhes  String?
  createdAt DateTime @default(now())
}


enum StatusSolicitacao {
  PENDENTE
  APROVADO
  RECUSADO
}

model SolicitacaoCancelamento {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  motivo        String
  status        StatusSolicitacao @default(PENDENTE)
  respostaAdmin String?
  createdAt     DateTime @default(now())
  resolvidoEm   DateTime?

  @@index([status, createdAt])
}

// Eventos anônimos de comportamento na página (mapa de calor).
// Sem PII: sessionId é um id aleatório do visitante, sem vínculo com User.
model HeatEvent {
  id        String   @id @default(cuid())
  sessionId String
  tipo      String   // "click" | "scroll" | "secao"
  path      String   @default("/")
  secao     String?  // id da seção (data-section)
  rotulo    String?  // rótulo do elemento clicado (data-heat / texto)
  xRel      Float?   // 0..1 relativo à largura da página
  yRel      Float?   // 0..1 relativo à altura total da página
  scrollPct Int?     // profundidade máxima de rolagem (0..100)
  dwellMs   Int?     // tempo acumulado na seção (ms)
  viewport  String?  // "mobile" | "desktop"
  createdAt DateTime @default(now())

  @@index([path, tipo, createdAt])
  @@index([createdAt])
}

/**
 * Contador de tentativas por janela de tempo.
 *
 * Fica no banco, e nao em memoria, porque cada requisicao na Vercel pode cair
 * numa instancia diferente: um contador em memoria zera sozinho e nao segura
 * ninguem. Uma linha por chave (acao + quem), com a janela gravada junto.
 *
 * As linhas vencidas sao apagadas pelo proprio uso e pelo cron diario — nao
 * vale um job so para isso.
 */
model RateLimit {
  chave     String   @id
  contagem  Int      @default(0)
  janelaFim DateTime
  createdAt DateTime @default(now())

  @@index([janelaFim])
}
