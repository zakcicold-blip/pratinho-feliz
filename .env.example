# Postgres — string "pooled" (usada em runtime pela aplicação)
DATABASE_URL="postgresql://usuario:senha@host-pooler.regiao.neon.tech/dbname?sslmode=require"

# Postgres — string "direta" / sem pooler (usada só pelo Prisma Migrate)
DIRECT_URL="postgresql://usuario:senha@host.regiao.neon.tech/dbname?sslmode=require"

# Chave secreta do NextAuth — gere uma nova para produção, nunca reaproveite a de dev.
# Gerar com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio-e-secreto"
