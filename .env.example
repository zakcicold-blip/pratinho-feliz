# Postgres — string "pooled" (usada em runtime pela aplicação)
DATABASE_URL="postgresql://usuario:senha@host-pooler.regiao.neon.tech/dbname?sslmode=require"

# Postgres — string "direta" / sem pooler (usada só pelo Prisma Migrate)
DIRECT_URL="postgresql://usuario:senha@host.regiao.neon.tech/dbname?sslmode=require"

# Chave secreta do NextAuth — gere uma nova para produção, nunca reaproveite a de dev.
# Gerar com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio-e-secreto"

# --- Stripe (assinatura + teste grátis de 7 dias) ---
# Chave secreta da API. Use sk_test_... em desenvolvimento e sk_live_... só em produção.
STRIPE_SECRET_KEY="sk_test_xxx"

# Id do preço mensal (R$ 29,90/mês) criado pelo script npm run stripe:setup. Formato price_...
STRIPE_PRICE_ID="price_xxx"

# Id do preço trimestral (R$ 59,90 a cada 3 meses). Também criado pelo stripe:setup.
STRIPE_PRICE_ID_TRIMESTRAL="price_xxx"

# Segredo de verificação do webhook (Stripe > Developers > Webhooks). Formato whsec_...
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Opcional: URL pública usada nas URLs de retorno quando não há cabeçalho de host.
# NEXT_PUBLIC_APP_URL="https://pratinho-feliz.vercel.app"

# --- Meta Conversions API (CAPI, server-side) ---
# Token da Conversions API (Events Manager > sua Pixel > Configurações). É SEGREDO.
# Sem ele, os eventos server-side (StartTrial/Purchase) simplesmente não são enviados.
META_CAPI_TOKEN="EAAG_xxx"

# Opcional: código de teste (Events Manager > Test Events) para validar sem
# poluir os dados reais. Remova quando terminar de testar.
# META_TEST_EVENT_CODE="TEST12345"

# ---------- Lembretes diarios (F1) ----------
# Trava geral: sem LEMBRETES_ATIVOS=1 nada e enviado, so registrado no log.
LEMBRETES_ATIVOS=
# Protege o cron /api/cron/lembretes. A Vercel envia como Bearer.
CRON_SECRET=
# E-mail (Resend)
RESEND_API_KEY=
EMAIL_REMETENTE="Pratinho Feliz <ola@pratinhofeliz.online>"
# WhatsApp (Meta Cloud API) — mensagem iniciada pelo negocio exige template aprovado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=

# ---------- Assistente "Pergunte ao Pratinho" (F6) ----------
# Sem esta chave o assistente aparece desativado, sem quebrar nenhuma tela.
ANTHROPIC_API_KEY=

# ---------- Somente desenvolvimento local ----------
# Login sem senha em /dev-login, para testar as telas logadas.
# NUNCA definir na Vercel. Mesmo se definida, o app so aceita quando
# NODE_ENV !== "production" — sao duas travas independentes.
DEV_LOGIN=

# Registra cada consulta SQL com a duracao, para achar N+1.
PRISMA_LOG=

# Conta de administrador criada pelo seed (nunca versionar a senha).
ADMIN_EMAIL=
ADMIN_SENHA=
